# Single source of truth for CI tool pins (Constitution IV).
#
# Sourced by ci/checks.sh and read by .github/workflows/ci.yml. Keep in lockstep
# with pyproject.toml [project.optional-dependencies].dev and with the `rev:`
# values in .pre-commit-config.yaml — a mismatch means CI and the pre-commit
# gate disagree, which is how a "green locally, red in CI" loop starts.
# tests/unit/test_version_pins.py asserts that lockstep mechanically; it fails
# if any of the three files drifts.
#
# These pins are ENFORCED, not announced: ci/checks.sh runs a preflight that
# refuses to execute a gate unless the interpreter and every tool on PATH report
# exactly the versions below. The preflight DERIVES its tool list from the
# <NAME>_VERSION keys in this file, so adding a pin here and forgetting to check
# it is a hard error rather than a silent gap — see ci/checks.sh preflight().
#
# Platform pins (charts, images, k3s, driver) live in docs/decisions/versions.md,
# not here. This file is only about the tools that run the gates.
#
# Verified 2026-08-08 against pypi.org / ghcr.io / docker.io; container digests
# re-resolved 2026-08-09 with `docker pull` + `docker inspect`. Re-verify before
# bumping. `python -m pip index versions <pkg>` is the check for the PyPI ones.
#
# PYTEST_COV_VERSION and COVERAGE_VERSION were added later and verified against
# pypi.org on 2026-08-15 — the banner date above does not cover them, and a
# reader must not have to infer which pins a verification statement includes.

# Python interpreter CI runs the gates on (plan.md Technical Context).
# pyproject.toml requires-python is >=3.12,<3.13; these must agree.
PYTHON_VERSION=3.12

# pypi.org/project/pip/26.2.1
# The installer itself. `.github/workflows/ci.yml` previously ran
# `python -m pip install --upgrade pip`: an unpinned upgrade to a mutable
# "latest", in a workflow whose own header argues that a mutable reference with
# repository access is unacceptable, immediately before the step that installs
# every other pin. Pinned here so bumping it is a reviewable diff like the rest.
#
# Deliberately in ci/checks.sh's PREFLIGHT_EXEMPT_PINS. pip is bootstrap-level —
# it is what INSTALLS the pinned toolchain, so CI upgrades it before that
# toolchain exists — and refusing to run a gate because an operator's local pip
# is a patch release behind would be a prerequisite out of all proportion to the
# risk it removes.
PIP_VERSION=26.2.1

# pypi.org/project/ruff/0.16.2  — matches .pre-commit-config.yaml rev v0.16.2
RUFF_VERSION=0.16.2

# pypi.org/project/mypy/2.3.0   — matches mirrors-mypy rev v2.3.0
MYPY_VERSION=2.3.0

# pypi.org/project/pytest/9.1.1
PYTEST_VERSION=9.1.1

# pypi.org/project/pytest-cov/7.1.0
# The coverage gate (FR-011a). 7.1.0 specifically, not an older line: it is the
# release that made total-coverage computation independent of reporting
# settings, so `--cov-fail-under` no longer varies with `--cov-report`. A
# threshold that moves with an unrelated flag is not a threshold.
# Declares `pytest>=7`, so it is compatible with PYTEST_VERSION above.
PYTEST_COV_VERSION=7.1.0

# pypi.org/project/coverage/7.15.4
# Pinned SEPARATELY from pytest-cov, which is only a shim: coverage is what
# actually computes the number the gate fails on. pytest-cov requests
# `coverage[toml]>=7.10.6`, an unpinned floor, and Principle IV has no
# transitive exemption — HATCHLING_VERSION is the standing precedent that a
# transitive dependency still gets a pin.
#
# Pinned WITHOUT the `[toml]` extras bracket: that extra only pulls tomli on
# Python <= 3.11.0a6, so it is inert on the pinned 3.12, and a bracketed name
# would not match the distribution key the pyproject lockstep test compares.
COVERAGE_VERSION=7.15.4

# Minimum measured statement coverage of src/orbital_drift, enforced by
# `sh ci/checks.sh coverage` (FR-011a). A pin rather than a literal in
# ci/checks.sh because Constitution III bans magic numbers in code, and
# tests/unit/test_checks_sh_behaviour.py asserts the stage's argv carries THIS
# value — so hardcoding it in the script fails the suite.
#
# Not a <NAME>_VERSION key, so versions_env_tools() does not derive a tool from
# it and no provenance URL applies. Same shape as MAX_ADDED_FILE_KB below.
#
# WHY THIS NUMBER, and why it passes today with no product code: coverage
# reports 100% for zero measurable statements, so the seven docstring-only
# __init__.py files under src/orbital_drift clear any threshold. The gate arms
# itself the moment the first executable line lands — measured, see
# docs/decisions/001-coverage-gate.md D-02. 85 is a floor for the
# pipeline-boundary code Phases 1-4 add, where Principle V already gives every
# boundary contract tests. Revisit and RAISE it when Phase 1 makes it
# load-bearing; lowering it to make a red build green is the failure mode.
COVERAGE_MIN_PERCENT=85

# pypi.org/project/pre-commit/4.6.1
PRE_COMMIT_VERSION=4.6.1

# pypi.org/project/hatchling/1.31.0
# The PEP 517 build backend named in pyproject.toml [build-system].requires.
# It is a pin like any other: `pip install -e ".[dev]"` — the one documented
# bootstrap command (README.md, Principle IV) and now the command CI itself
# runs — resolves it in an isolated build environment, so an unpinned backend
# would be a silently floating dependency of every install this project makes.
# Not probed by the preflight: it is a build-time-only dependency and is not
# importable from the target interpreter after an editable install completes.
HATCHLING_VERSION=1.31.0

# github.com/gitleaks/gitleaks/releases/tag/v8.30.1
# Run as a pinned container in BOTH pre-commit and CI so the two gates cannot
# drift apart, and so neither requires a local Go toolchain.
#
# DIGEST-PINNED. A tag is mutable: `v8.30.1` can be re-pushed to point at
# different bytes, and this workflow's own header argues that a mutable
# reference is unacceptable for anything with repository access. The
# `:tag@sha256:` form keeps the tag readable while making docker resolve the
# content by digest — the tag becomes a comment that cannot lie about content.
# ci/checks.sh's require_pinned_image() catches a VERSION rewrite; only the
# digest catches a CONTENT rewrite that keeps the version string.
GITLEAKS_VERSION=8.30.1
GITLEAKS_DIGEST=sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f
GITLEAKS_IMAGE=ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f

# hub.docker.com/r/koalaman/shellcheck/tags — v0.11.0
# ci/checks.sh is POSIX sh destined for dash on node A and was the only unlinted
# file in the repo. Run as a pinned container for the same reason gitleaks is:
# no Haskell toolchain exists on the Windows authoring box, and the upstream
# koalaman/shellcheck-precommit repo's newest tag is v0.9.0, which would pin the
# linter two minor versions behind the one we actually want.
#
# Digest-pinned for the same reason as gitleaks, and version-asserted by
# ci/checks.sh before stage_hooks runs the hook that uses it.
#
# (Do not start a comment line in this file with the word "shellcheck": with -x
# the linter parses this file as sourced shell and reads such a line as a
# directive, failing with SC1072/SC1073.)
SHELLCHECK_VERSION=0.11.0
SHELLCHECK_DIGEST=sha256:61862eba1fcf09a484ebcc6feea46f1782532571a34ed51fedf90dd25f925a8d
SHELLCHECK_IMAGE=koalaman/shellcheck:v0.11.0@sha256:61862eba1fcf09a484ebcc6feea46f1782532571a34ed51fedf90dd25f925a8d

# hub.docker.com/r/hashicorp/terraform/tags — 1.15.8. Resolved via the Docker
# Registry HTTP API v2 directly (bearer token from auth.docker.io, manifest
# digest from registry-1.docker.io), not `docker pull` + `docker inspect`
# (pin-a-tool's default method) — no Docker daemon or terraform binary existed
# in the agent environment that first resolved this pin. The method was
# validated before trusting it: re-deriving SHELLCHECK_DIGEST above via the
# identical query reproduced it byte-for-byte. Full recipe in
# docs/decisions/007-terraform-fmt-hook.md. Independently corroborated via
# releases.hashicorp.com/terraform/1.15.8/ (GitHub-release side of HashiCorp's
# distribution) and internal/command/version.go at the matching v1.15.8 tag.
# RE-VERIFY before this pin is bumped — HashiCorp ships patch releases often.
#
# UNLIKE gitleaks/shellcheck above, this repository's Docker Hub tags carry NO
# "v" prefix (confirmed against the registry's own tag list: "1.15.8" exists,
# "v1.15.8" does not) — a real difference in this vendor's tagging convention,
# not an inconsistency in this file. The CLI's own printed version banner
# ("Terraform v1.15.8", confirmed against a real pulled-and-run binary,
# `terraform version` -> "Terraform v1.15.8\non linux_amd64") DOES carry the
# "v", which terraform_reported_version() in ci/checks.sh strips.
#
# Digest-pinned for the same reason as gitleaks/shellcheck, and
# version-asserted by ci/checks.sh before stage_hooks runs the hook that uses
# it. This is the multi-arch MANIFEST-LIST digest (the same convention already
# used for SHELLCHECK_DIGEST above), covering linux/386, linux/amd64,
# linux/arm64, linux/arm/v6, linux/s390x.
TERRAFORM_VERSION=1.15.8
TERRAFORM_DIGEST=sha256:7ae513256f7ce67879e218ae8593d6fbe216ec9e123abe6c94e4e10704857963
TERRAFORM_IMAGE=hashicorp/terraform:1.15.8@sha256:7ae513256f7ce67879e218ae8593d6fbe216ec9e123abe6c94e4e10704857963

# GitHub-hosted runner label. `ubuntu-latest` is a MUTABLE pin — it moved from
# 22.04 to 24.04 mid-2025 and will move again — which this workflow's own header
# argues against. Pin the LTS explicitly and bump it deliberately.
CI_RUNNER_IMAGE=ubuntu-24.04

# Largest file `check-added-large-files --enforce-all` will accept, in KiB.
# Lives here rather than only in .pre-commit-config.yaml so the threshold is a
# reviewable pin and tests/unit/test_ci_contract.py can assert the hook argument
# matches it. 1 MiB: every legitimate artifact in this repo is text (YAML, TF,
# Python, Markdown); datasets and model weights are addressed by lakeFS commit
# and MLflow run ID (Constitution IV) and must never be in git at all.
MAX_ADDED_FILE_KB=1024
