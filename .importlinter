[importlinter]
root_packages =
    orbital_drift
include_external_packages = True

# TODO(phase-1-adapters): expand this scoped additive contract to the intended
# full sequence serve -> quality/observability -> config -> ports -> domain
# once the existing flat modules have been migrated into those packages. The
# repository now has a quality package (hardcode_scan.py, dep_contract.py —
# RB-010 Part 7) and config is still a flat module. There is no `adapters/`
# package in this repository and none is planned; `ports/` is the real
# hexagonal package (already a layer in the contract below) — a hexagonal
# adapter, once one exists, is wired there or alongside the existing
# pipeline-stage package it serves (registry/, drift/, ...), not under a
# separate top-level `adapters/` directory (RB-010 Part 8 correction).
[importlinter:contract:layers]
name = New core ports depend only on the domain
type = layers
layers =
    orbital_drift.ports
    orbital_drift.domain

[importlinter:contract:forbidden]
name = Domain and ports do not depend on third-party runtime libraries
type = forbidden
source_modules =
    orbital_drift.domain
    orbital_drift.ports
forbidden_modules =
    numpy
    scipy
    torch
    pydantic
    pydantic_settings
    requests
    fastapi
    sklearn
    esda
    libpysal

[importlinter:contract:independence]
name = Independent geometry and temporal primitives
type = independence
modules =
    orbital_drift.domain.geometry
    orbital_drift.domain.temporal
